# MentorHub production environment template
# Copy to .env.production on the deployment server and replace all placeholder secrets.

DB_NAME=eduagent
DB_USER=eduagent_user
DB_PASSWORD=change-me

DEEPSEEK_API_KEY=change-me
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_CODER=deepseek-coder

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me

TAVILY_API_KEY=

LOG_LEVEL=INFO
DEFAULT_TENANT_ID=tenant_default

# Host path containing embedding/reranker/classifier model folders.
MODELS_DIR=/opt/mentorhub/models

# Public HTTP port exposed by the frontend container.
HTTP_PORT=80
