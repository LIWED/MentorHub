{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "EduAgent QA 模块执行逻辑",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "views": [
      {"id": "rag_happy_path", "label": "高置信度 RAG 主链路", "focus": ["request", "classify", "retrieve", "rag_generate", "finish"], "note": "精排 Top-1 分数达到 0.75 时，以 Top-3 文档生成带来源的回答。"},
      {"id": "query_routing", "label": "问题类型路由", "focus": ["classify", "query_expand", "non_rag"], "note": "GENERAL 跳过检索；VAGUE 用 HyDE；BROAD 改写多个子 Query。"},
      {"id": "fallback_path", "label": "低置信度兜底", "focus": ["retrieve", "non_rag", "finish"], "note": "低置信度走通用模型直答；可注入联网结果并异步登记待补充知识。"}
    ]
  },
  "lanes": [
    {"id": "api", "label": "API 与 SSE"},
    {"id": "routing", "label": "问题理解与路由"},
    {"id": "rag", "label": "RAG 检索与生成"}
  ],
  "phases": [
    {"id": "intake", "label": "接入", "fromCol": 0, "toCol": 0},
    {"id": "route", "label": "分类与改写", "fromCol": 1, "toCol": 2, "variant": "emphasis"},
    {"id": "answer", "label": "检索、生成与收尾", "fromCol": 3, "toCol": 5, "variant": "dashed"}
  ],
  "mainPath": ["request", "classify", "retrieve", "rag_generate", "finish"],
  "semanticChecks": {
    "allowedRoots": ["request"],
    "allowedTerminals": ["finish"],
    "requiredPaths": [
      {"from": "classify", "to": "retrieve"},
      {"from": "retrieve", "to": "rag_generate"},
      {"from": "rag_generate", "to": "finish"}
    ]
  },
  "nodes": [
    {"id": "request", "lane": "api", "col": 0, "type": "frontend", "label": "接收问题", "sublabel": "/chat 或 /chat/stream", "width": 150},
    {"id": "finish", "lane": "api", "col": 5, "type": "backend", "label": "保存并返回", "sublabel": "MemorySaver + JSON / SSE 元数据", "width": 170},
    {"id": "classify", "lane": "routing", "col": 1, "type": "backend", "label": "分类并加载摘要", "sublabel": "规则 → MiniLM → RAG 策略", "width": 165},
    {"id": "query_expand", "lane": "routing", "col": 2, "type": "backend", "label": "查询扩展", "sublabel": "VAGUE：HyDE · BROAD：Multi-Query", "width": 180},
    {"id": "non_rag", "lane": "routing", "col": 4, "type": "backend", "label": "非 RAG 生成", "sublabel": "直答 / Web / 入队", "width": 185},
    {"id": "retrieve", "lane": "rag", "col": 3, "type": "backend", "label": "混合召回与精排", "sublabel": "BGE-M3 → Milvus → BGE-Reranker", "tag": "Top-1 阈值 0.75", "width": 185},
    {"id": "rag_generate", "lane": "rag", "col": 5, "type": "backend", "label": "RAG 回答生成", "sublabel": "Top-3 文档 + 历史摘要 + 来源", "width": 165}
  ],
  "edges": [
    {"id": "request_classify", "from": "request", "to": "classify", "label": "HumanMessage + 用户/租户/会话上下文", "role": "main", "variant": "emphasis"},
    {"id": "precise_retrieve", "from": "classify", "to": "retrieve", "label": "PRECISE：原 Query", "role": "main"},
    {"id": "classify_expand", "from": "classify", "to": "query_expand", "label": "VAGUE / BROAD", "role": "branch"},
    {"id": "expand_retrieve", "from": "query_expand", "to": "retrieve", "label": "HyDE 或并行检索后合并去重", "role": "branch"},
    {"id": "general_non_rag", "from": "classify", "to": "non_rag", "label": "GENERAL", "role": "branch"},
    {"id": "high_confidence_rag", "from": "retrieve", "to": "rag_generate", "label": "Top-1 分数 ≥ 0.75", "role": "main", "variant": "emphasis"},
    {"id": "low_confidence_non_rag", "from": "retrieve", "to": "non_rag", "label": "< 0.75 且不联网", "role": "branch"},
    {"id": "rag_finish", "from": "rag_generate", "to": "finish", "label": "答案、来源、置信度", "role": "main"},
    {"id": "non_rag_finish", "from": "non_rag", "to": "finish", "label": "通用 / Web 增强回答", "role": "branch"}
  ]
}
