# ============================================================
# EduAgent 环境变量模板
# 使用方式：cp .env.example .env.local 后填入真实值
# .env.local 已加入 .gitignore，绝不提交 Git
# ============================================================

# ===== 数据库（PostgreSQL）=====
# 本机已有 PG 跑在 5432，EduAgent 使用 5433 隔离
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eduagent
DB_USER=eduagent_user
DB_PASSWORD=your_db_password

# ===== Redis =====
# 本机已有 Redis 跑在 6379，EduAgent 使用 6380 隔离
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=your_redis_password

# ===== Milvus =====
# 本机已有 Milvus 跑在 19530，EduAgent 使用 19531 隔离
MILVUS_HOST=localhost
MILVUS_PORT=19531

# ===== 大模型 API =====
# 必填：DeepSeek API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_CODER=deepseek-coder

# 通义千问 API Key（VL 视觉模型使用，可选）
#QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#QWEN_MODEL_VL=qwen3-vl-plus

# Anthropic 兼容网关（可选）
#ANTHROPIC_AUTH_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#ANTHROPIC_BASE_URL=https://api.example.com

# ===== 本地模型路径 =====
RERANKER_MODEL_PATH=models/reranker/bge-reranker-large
CLASSIFIER_MODEL_PATH=models/classifier/all-MiniLM-L6-v2
FINETUNED_CLASSIFIER_PATH=models/classifier/query-classifier-finetuned
BGE_M3_MODEL_PATH=models/embedding/bge-m3

# ===== MinerU（仅知识入库阶段）=====
# 推荐单独创建 MinerU 环境，不安装进 EduAgent 主环境。
# Windows 示例：F:\AiStudy\AiSoftware\aiconda\envs\MinerU\python.exe
MINERU_PYTHON_EXECUTABLE=
MINERU_TIER=basic
MINERU_OUTPUT_ROOT=./data/mineru
MINERU_TIMEOUT_SECONDS=900
# 国内下载模型可设为 modelscope；留空使用默认源
MINERU_MODEL_SOURCE=

# ===== 知识库上传 =====
# 管理员从前端上传课程文档/网页文件夹时的本地保存目录。
KNOWLEDGE_UPLOAD_ROOT=./data/knowledge_uploads
KNOWLEDGE_UPLOAD_MAX_FILE_MB=100

# ===== JWT 认证 =====
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Langfuse（下阶段启用，本阶段留空）=====
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3001

# ===== LLM 速率限制（防止 API 费用失控）=====
# 每位学员每日 LLM 调用上限（Redis 计数，超限返回友好提示）
# 生产阶段按实际用量调整；本地开发可设置为 0（0 = 不限制）
LLM_DAILY_LIMIT_PER_STUDENT=0

# ===== 应用配置 =====
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== 多租户默认值（本地开发用）=====
DEFAULT_TENANT_ID=tenant_default

# ===== Web 搜索（MCP Server 使用）=====
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
